# Required
# Replace with your MongoDB Atlas or local MongoDB connection string.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret

# Local server settings
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Optional: required only for SMS OTP delivery.
TWILIO_PHONE=+<country-code-and-phone-number>
TWILIO_SID=
TWILIO_AUTH_TOKEN=

# Optional: required only for Cloudinary image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Present in the project's config; currently not used by application code.
EMAIL_USERNAME=
EMAIL_PASSWORD=
